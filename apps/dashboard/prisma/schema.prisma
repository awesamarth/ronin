generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Org {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  githubOrgId          String?
  githubOrgLogin       String?  @unique
  githubInstallationId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  repos         Repository[]
  channels      Channel[]
  conversations Conversation[]
  runs          Run[]
  executions    AgentExecution[]
  artifacts     Artifact[]
  githubEvents  GitHubEvent[]
  auditLogs     AuditLog[]
}

model Repository {
  id             String   @id @default(cuid())
  orgId          String
  githubRepoId   String?  @unique
  fullName       String
  defaultBranch  String   @default("main")
  latestKnownSha String?
  watchedEnabled Boolean  @default(true)
  capabilities   String   @default("docs,pr_review,support_answers,try_fix,auto_report_pr")
  harnessType    String   @default("pi")
  model          String?
  provider       String?
  reasoning      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channels     Channel[]
  runs         Run[]
  artifacts    Artifact[]
  githubEvents GitHubEvent[]
  auditLogs    AuditLog[]

  @@unique([orgId, fullName])
  @@index([orgId])
}

model Channel {
  id                String   @id @default(cuid())
  orgId             String
  defaultRepoId     String?
  platform          String
  platformTeamId    String?
  platformChannelId String
  displayName       String?
  allowedRepoIds    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultRepo   Repository?    @relation(fields: [defaultRepoId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@unique([platform, platformTeamId, platformChannelId])
  @@index([orgId])
}

model Conversation {
  id                String   @id @default(cuid())
  orgId             String?
  channelId         String?
  scope             String
  platform          String
  platformTeamId    String
  platformChannelId String
  platformThreadId  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org      Org?                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel  Channel?              @relation(fields: [channelId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]
  runs     Run[]

  @@unique([platform, platformTeamId, platformChannelId, platformThreadId], map: "Conversation_external_identity_key")
  @@index([orgId, updatedAt])
  @@index([channelId])
}

model ConversationMessage {
  id                String   @id @default(cuid())
  conversationId    String
  externalMessageId String
  role              String
  actorId           String?
  actorName         String?
  content           String
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceRun    Run?         @relation("RunSourceMessage")

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
}

model Run {
  id                 String    @id
  orgId              String
  repoId             String?
  conversationId     String?
  sourceMessageId    String?   @unique
  kind               String
  status             String
  summary            String?
  input              String
  output             String?
  centaurThreadKey   String?
  centaurExecutionId String?
  startedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?
  attempt            Int       @default(0)

  org           Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo          Repository?          @relation(fields: [repoId], references: [id], onDelete: SetNull)
  conversation  Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage ConversationMessage? @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  executions    AgentExecution[]
  artifacts     Artifact[]
  auditLogs     AuditLog[]

  @@index([orgId, kind, createdAt])
  @@index([repoId])
  @@index([conversationId, createdAt])
}

model AgentExecution {
  id                 String    @id @default(cuid())
  orgId              String
  runId              String
  purpose            String
  idempotencyKey     String
  status             String
  backend            String?
  centaurThreadKey   String?
  centaurExecutionId String?
  harness            String?
  model              String?
  provider           String?
  reasoning          String?
  output             String?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idempotencyKey])
  @@index([orgId, createdAt])
  @@index([centaurExecutionId])
}

model Artifact {
  id        String   @id @default(cuid())
  orgId     String
  repoId    String?
  runId     String?
  kind      String
  title     String
  path      String?
  content   String
  createdAt DateTime @default(now())

  org  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)
  run  Run?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([orgId, kind, createdAt])
  @@index([repoId])
  @@index([runId])
}

model GitHubEvent {
  id             String    @id @default(cuid())
  orgId          String
  repoId         String?
  deliveryId     String?   @unique
  eventName      String
  action         String?
  installationId String?
  payload        String
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  org  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([orgId, eventName, createdAt])
  @@index([repoId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  repoId    String?
  runId     String?
  actorType String
  actorId   String?
  action    String
  target    String?
  metadata  String?
  createdAt DateTime @default(now())

  org  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)
  run  Run?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([repoId])
  @@index([runId])
}
