generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Org {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  githubOrgId          String?
  githubOrgLogin       String?  @unique
  githubInstallationId String?  @unique
  profile              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships        OrgMembership[]
  repos              Repository[]
  channels           Channel[]
  channelRoutes      ChannelRepository[]
  slackInstallations SlackInstallation[]
  conversations      Conversation[]
  runs               Run[]
  executions         AgentExecution[]
  artifacts          Artifact[]
  githubEvents       GitHubEvent[]
  auditLogs          AuditLog[]
}

model User {
  id              String   @id @default(cuid())
  displayName     String?
  avatarUrl       String?
  lastActiveOrgId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identities               UserIdentity[]
  memberships              OrgMembership[]
  githubInstallationAccess GitHubInstallationAccess[]
  messages                 ConversationMessage[]
  runs                     Run[]
}

model UserIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  login             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model GitHubInstallationAccess {
  id             String   @id @default(cuid())
  userId         String
  installationId String
  verifiedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([installationId])
}

model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId, status])
}

model Repository {
  id             String   @id @default(cuid())
  orgId          String
  githubRepoId   String?  @unique
  fullName       String
  defaultBranch  String   @default("main")
  latestKnownSha String?
  watchedEnabled Boolean  @default(true)
  capabilities   String   @default("docs,pr_review,support_answers,try_fix,auto_report_pr")
  harnessType    String   @default("pi")
  model          String?
  provider       String?
  reasoning      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org           Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channels      Channel[]           @relation("ChannelDefaultRepo")
  channelRoutes ChannelRepository[]
  runs          Run[]
  artifacts     Artifact[]
  githubEvents  GitHubEvent[]
  auditLogs     AuditLog[]

  @@unique([orgId, fullName])
  @@index([orgId])
}

model SlackInstallation {
  id          String   @id @default(cuid())
  teamId      String   @unique
  orgId       String?
  teamName    String?
  installedAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Org?                   @relation(fields: [orgId], references: [id], onDelete: SetNull)
  usage HostedInferenceUsage[]

  @@index([orgId])
}

model HostedInferenceUsage {
  id                  String    @id @default(cuid())
  slackInstallationId String
  actorId             String
  requestId           String
  model               String
  status              String
  inputTokens         Int?
  outputTokens        Int?
  error               String?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  slackInstallation SlackInstallation @relation(fields: [slackInstallationId], references: [id], onDelete: Cascade)

  @@unique([slackInstallationId, requestId], map: "HostedInferenceUsage_installation_request_key")
  @@index([slackInstallationId, actorId, createdAt], map: "HostedInferenceUsage_installation_actor_created_idx")
  @@index([slackInstallationId, status, createdAt], map: "HostedInferenceUsage_installation_status_created_idx")
}

model Channel {
  id                String   @id @default(cuid())
  orgId             String
  defaultRepoId     String?
  platform          String
  platformTeamId    String?
  platformChannelId String
  displayName       String?
  accessMode        String   @default("internal")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org           Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultRepo   Repository?         @relation("ChannelDefaultRepo", fields: [defaultRepoId], references: [id], onDelete: SetNull)
  allowedRepos  ChannelRepository[]
  conversations Conversation[]

  @@unique([platform, platformTeamId, platformChannelId])
  @@index([orgId])
}

model ChannelRepository {
  channelId String
  repoId    String
  orgId     String
  createdAt DateTime @default(now())

  channel Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  repo    Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  org     Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([channelId, repoId])
  @@index([orgId])
  @@index([repoId])
}

model Conversation {
  id                String   @id @default(cuid())
  orgId             String?
  channelId         String?
  scope             String
  platform          String
  platformTeamId    String
  platformChannelId String
  platformThreadId  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org      Org?                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel  Channel?              @relation(fields: [channelId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]
  runs     Run[]

  @@unique([platform, platformTeamId, platformChannelId, platformThreadId], map: "Conversation_external_identity_key")
  @@index([orgId, updatedAt])
  @@index([channelId])
}

model ConversationMessage {
  id                String   @id @default(cuid())
  conversationId    String
  externalMessageId String
  role              String
  actorId           String?
  actorName         String?
  actorUserId       String?
  content           String
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  sourceRun    Run?         @relation("RunSourceMessage")

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([actorUserId])
}

model Run {
  id                 String    @id
  orgId              String
  repoId             String?
  conversationId     String?
  sourceMessageId    String?   @unique
  actorUserId        String?
  authorizedAction   String?
  authorization      String?
  kind               String
  status             String
  summary            String?
  input              String
  output             String?
  centaurThreadKey   String?
  centaurExecutionId String?
  startedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?
  attempt            Int       @default(0)

  org           Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo          Repository?          @relation(fields: [repoId], references: [id], onDelete: Restrict)
  conversation  Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sourceMessage ConversationMessage? @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Restrict)
  actorUser     User?                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  executions    AgentExecution[]
  artifacts     Artifact[]
  auditLogs     AuditLog[]

  @@index([orgId, kind, createdAt])
  @@index([repoId])
  @@index([conversationId, createdAt])
  @@index([actorUserId])
}

model AgentExecution {
  id                 String    @id @default(cuid())
  orgId              String
  runId              String
  purpose            String
  idempotencyKey     String
  status             String
  backend            String?
  centaurThreadKey   String?
  centaurExecutionId String?
  harness            String?
  model              String?
  provider           String?
  reasoning          String?
  output             String?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idempotencyKey])
  @@index([orgId, createdAt])
  @@index([centaurExecutionId])
}

model Artifact {
  id        String   @id @default(cuid())
  orgId     String
  repoId    String?
  runId     String?
  kind      String
  title     String
  path      String?
  content   String
  createdAt DateTime @default(now())

  org  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)
  run  Run?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([orgId, kind, createdAt])
  @@index([repoId])
  @@index([runId])
}

model GitHubEvent {
  id             String    @id @default(cuid())
  orgId          String
  repoId         String?
  deliveryId     String?   @unique
  eventName      String
  action         String?
  installationId String?
  payload        String
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  org  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([orgId, eventName, createdAt])
  @@index([repoId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  repoId    String?
  runId     String?
  actorType String
  actorId   String?
  action    String
  target    String?
  metadata  String?
  createdAt DateTime @default(now())

  org  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo Repository? @relation(fields: [repoId], references: [id], onDelete: SetNull)
  run  Run?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([repoId])
  @@index([runId])
}
