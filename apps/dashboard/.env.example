DATABASE_URL="postgresql://ronin:change-me@127.0.0.1:5432/ronin"

GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_PATH="../../key.pem"
GITHUB_INSTALLATION_ID=""

# Operator authentication
RONIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional private-beta admission gate; omit for open tenant onboarding.
RONIN_ALLOWED_GITHUB_USERS="github-login"
RONIN_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_DOCS_URL="http://localhost:3005/docs"
# Development only; startup/auth fails if enabled in production.
# RONIN_AUTH_DISABLED="true"

# Centaur execution backend
CENTAUR_API_URL="http://127.0.0.1:8080"
CENTAUR_API_KEY=""
RONIN_HARNESS="pi"
# RONIN_MODEL=""
# RONIN_PROVIDER=""
# RONIN_REASONING=""
# CENTAUR_TIMEOUT_MS="600000"
# Workspace turns recover an already-pushed branch when this final-report deadline is reached.
RONIN_WORKSPACE_TIMEOUT_MS="180000"
# Fail closed unless Centaur creates Ronin sessions without a shared repo cache.
RONIN_CENTAUR_REPO_CACHE_ACCESS="none"
# Server-only Centaur Console admin API used to attach encrypted, per-run repo credentials.
IRON_CONTROL_API_URL="http://centaur-console:3000"
IRON_CONTROL_API_KEY=""
# Optional Host override for local port-forwarding through Rails host authorization.
IRON_CONTROL_HOST=""

# Hosted inference for Slack DMs (OpenAI Responses-compatible endpoint; no tools or repo access)
RONIN_HOSTED_LLM_API_KEY=""
RONIN_HOSTED_LLM_URL="https://api.openai.com/v1/responses"
RONIN_HOSTED_MODEL="gpt-5-mini"
RONIN_HOSTED_USER_REQUESTS_PER_MINUTE="5"
RONIN_HOSTED_USER_REQUESTS_PER_DAY="25"
RONIN_HOSTED_WORKSPACE_REQUESTS_PER_DAY="200"
RONIN_HOSTED_WORKSPACE_CONCURRENCY="2"
RONIN_HOSTED_MAX_PROMPT_CHARS="16000"
RONIN_HOSTED_MAX_OUTPUT_TOKENS="800"
RONIN_HOSTED_TIMEOUT_MS="30000"

# Slack connector (Socket Mode for local dev)
SLACK_APP_ID=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
SLACK_VERIFICATION_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_BOT_TOKEN=""
SLACK_SOCKET_MODE="true"
